# Copy to .env only for local deployment. Never commit the resulting file.

# First-run administrator.
# If unset, an empty database creates admin / 123456 with a forced
# password change. Override both values for any shared or LAN deployment.
LOCAL_VIDEO_AUTO_BOOTSTRAP_ADMIN=1
LOCAL_VIDEO_BOOTSTRAP_ADMIN_USERNAME=admin
# LOCAL_VIDEO_BOOTSTRAP_ADMIN_PASSWORD=change-this-before-lan
# LOCAL_VIDEO_ALLOW_DEFAULT_ADMIN_LAN=0

# Network and data paths
LOCAL_VIDEO_PORT=8766
LOCAL_VIDEO_DATA_DIR=/path/to/local-video-site/local_video_site/data
# LOCAL_VIDEO_ROOTS=/path/to/videos

# Optional runtime overrides
# LOCAL_VIDEO_FFMPEG_CONCURRENCY=2
# LOCAL_VIDEO_FFMPEG=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# LOCAL_VIDEO_EXTERNAL_PLAYBACK_TOKEN_SECONDS=300
# LOCAL_VIDEO_PLAYBACK_TOKEN_SECRET=/path/to/playback-token-secret
# LOCAL_VIDEO_PLAYBACK_CACHE_MAX_BYTES=21474836480
# LOCAL_VIDEO_COVER_PREVIEW_DIR=/path/to/cover-preview-cache
# LOCAL_VIDEO_COVER_PREVIEW_MAX_BYTES=268435456
# LOCAL_VIDEO_SERIES_COVERS=/path/to/series-covers
# LOCAL_VIDEO_SEASON_COVERS=/path/to/season-covers
